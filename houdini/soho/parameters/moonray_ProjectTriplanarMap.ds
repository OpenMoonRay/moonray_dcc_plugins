            disablewhen "{ xn__inputspositive_x_swap_st_control_6sb == block } { xn__inputspositive_x_swap_st_control_6sb == none }"
            parmtag { "usdvaluetype" "bool" }
        }
        parm {
            name    "xn__inputspositive_x_rotation_control_tub"
            label   "inputs:positive_x_rotation"
            type    string
            default { "none" }
