            range   { 0 10 }
            parmtag { "usdvaluetype" "float2" }
        }
        parm {
            name    "xn__inputspositive_x_wrap_around_control_pzb"
            label   "inputs:positive_x_wrap_around"
            type    string
            default { "none" }
